#include <stdio.h>

int main() {

    int n,i,m,a[100],b[100],j,temp[100],k,t;
    scanf("%d",&n); 
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);
    scanf("%d",&m); 
    t=n+m;   
    for(j=0;j<m;j++)
        scanf("%d",&b[j]);
    i=0;
    j=0;
    k=0;
    while(i < n && j < m)
    {
        if(a[i] < b[j])
            temp[k++] = a[i++];
        else
            temp[k++] = b[j++];
    }

    while(i < n)
        temp[k++] = a[i++];

    while(j < m)
        temp[k++] = b[j++];

    for(i = 0; i < t; i++)
        printf("%d ", temp[i]);
    return 0;
}

from collections import deque
n, m = map(int, input().split())
grid = []
for i in range(n):
    grid.append(list(map(int, input().split())))
q = deque()
fresh = 0
for i in range(n):
    for j in range(m):
        if grid[i][j] == 2:
            q.append((i, j))
        elif grid[i][j] == 1:
            fresh += 1
time = 0
directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]
while q and fresh > 0:
    size = len(q)
    for _ in range(size):
        r, c = q.popleft()
        for dr, dc in directions:
            nr = r + dr
            nc = c + dc
            if 0 <= nr < n and 0 <= nc < m and grid[nr][nc] == 1:
                grid[nr][nc] = 2
                fresh -= 1
                q.append((nr, nc))
    time += 1
if fresh == 0:
    print(time)
else:
    print(-1)

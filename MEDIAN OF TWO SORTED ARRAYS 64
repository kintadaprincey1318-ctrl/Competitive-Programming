#include <stdio.h>
double medianOfTwoSortedArrays(int a[], int n, int b[], int m) {
    int i = 0, j = 0, count = 0;
    int total = n + m;
    int prev = 0, curr = 0;
    while (count <= total / 2) {
        prev = curr;
        if (i < n && (j >= m || a[i] <= b[j])) {
            curr = a[i];
            i++;
        } else {
            curr = b[j];
            j++;
        }
        count++;
    }
    if (total % 2 == 1) {
        return curr;
    } else {
        return (prev + curr) / 2.0;
    }
}
int main() {
    int n, m;
    scanf("%d %d", &n, &m);
    int a[n], b[m];
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    for (int i = 0; i < m; i++) {
        scanf("%d", &b[i]);
    }
    printf("%.1f", medianOfTwoSortedArrays(a, n, b, m));
    return 0;
}

#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n;
    scanf("%d", &n);
    int nums[n];
    for(int i = 0; i < n; i++)
        scanf("%d", &nums[i]);
    int max = nums[0];
    for(int i = 1; i < n; i++)
    {
        if(nums[i] > max)  
            max = nums[i];
    }
    int aux[max + 1];
    for(int i = 0; i <= max; i++)
        aux[i] = 0;
    for(int i = 0; i < n; i++)
        aux[nums[i]]++;
    for(int i = 1; i <= max; i++)
        aux[i] += aux[i - 1];
    int res[n];
    for(int i = n - 1; i >= 0; i--)
    {
        res[aux[nums[i]] - 1] = nums[i];
        aux[nums[i]]--;
    }
    for(int i = 0; i < n; i++)
        printf("%d ", res[i]);
    return 0;
}

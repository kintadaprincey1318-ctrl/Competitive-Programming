inputs=input().split()
a=int(inputs[0])
b=int(inputs[1])
c3 = 1
while a % 2 == 0 and b % 2 == 0:
    c3 *= 2
    a //= 2
    b //= 2
while a != b:
    if a % 2 == 0:
        a //= 2
    elif b % 2 == 0:
        b //= 2
    elif a > b:
        a = (a - b) // 2
    else:
        b = (b - a) // 2
print(c3 * a)
